# StockPilot — production environment for the VPS.
#
# HOW TO USE: on the server, copy this file to `.env.prod`, fill in the three
# values marked CHANGE ME, and save. `.env.prod` is gitignored and must never
# be committed — it holds secrets and passwords.
#
#   cp .env.prod.example .env.prod
#   nano .env.prod
#
# Compose reads it via:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Domain ────────────────────────────────────────────────────────────────────
# CHANGE ME — the domain the site will be served on, WITHOUT https:// and
# without a trailing slash. Must already point at this VPS's IP address
# (A record, set in the Cyber_Folks DNS panel).
DOMAIN=stocksignal.pl

# ── Database ──────────────────────────────────────────────────────────────────
# CHANGE ME — invent a long random password. Generate one on the server with:
#   openssl rand -hex 24
# Use LETTERS AND DIGITS ONLY. The password is pasted into a connection URL
# (postgresql+asyncpg://user:PASSWORD@db:5432/…), so characters like / @ : # ? $
# would break that URL — `rand -hex` avoids all of them.
# It is only ever used between the containers, so you never have to type it again.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

POSTGRES_USER=stockpilot
POSTGRES_DB=stockpilot

# ── Daily data refresh (Europe/Warsaw time) ───────────────────────────────────
# GPW closes around 17:05; 18:00 gives the data provider time to publish.
STOCKPILOT_INGEST_HOUR=18
STOCKPILOT_INGEST_MINUTE=0

# ── Markets ───────────────────────────────────────────────────────────────────
# Which stock markets the site serves, comma-separated: gpw, us, de, fr, nl, uk
# — or "all". The GPW is always on. "all" needs ~700 MB for the backend (vs
# ~320 MB for the GPW alone) — see agent/DEPLOYMENT.md §"switching markets on".
STOCKPILOT_MARKETS=all
# The US market has its own nightly run, in New York time (≈ 23:15 Warsaw).
STOCKPILOT_US_INGEST_HOUR=17
STOCKPILOT_US_INGEST_MINUTE=15

# ── Live prices ───────────────────────────────────────────────────────────────
# While an exchange is open, today's prices are downloaded every hour and shown
# beside the ratings (which stay on finished sessions). false switches it off;
# the cadence must divide an hour (5, 10, 15, 20, 30 or 60 minutes).
STOCKPILOT_LIVE_PRICES_ENABLED=true
STOCKPILOT_LIVE_PRICES_INTERVAL_MINUTES=60

# ── Local port ────────────────────────────────────────────────────────────────
# Where the web container listens on the VPS's loopback interface. Change only
# if something else already uses 8080 (then update deploy/nginx/stockpilot.conf too).
WEB_PORT=8080

# ── Action log (audit trail) ──────────────────────────────────────────────────
# Every API call and background job is recorded: what was done and when. Rows
# go to the `action_logs` table AND to a plain file on this server:
#   ~/stockpilot/logs/actions.jsonl   (read it with: tail -f logs/actions.jsonl)
# The file rotates at 10 MB and keeps 5 old copies. Rows older than this many
# days are deleted from the table automatically, so it cannot grow forever.
STOCKPILOT_ACTION_LOG_RETENTION_DAYS=30

# ── Admin API token (the System page) ─────────────────────────────────────────
# CHANGE ME — invent a long random string, e.g.
#   openssl rand -hex 24
# The System page (/system) answers "did last night's refresh run?" and lists
# recent errors — including stack traces, file paths and visitor IP addresses.
# This token is REQUIRED in production. Open https://your-domain/system once
# and paste the same value into the "Access" box at the bottom of the page
# (it is stored in your browser only).
STOCKPILOT_ADMIN_TOKEN=change-me-to-a-long-random-string

# ── Sign-in / user accounts ───────────────────────────────────────────────────
# Visitors can create an account and sign in. The site itself stays public —
# every page is readable without one — so this only affects the sign-in.
#
# OPTIONAL — deliberately left empty (owner's decision, 2026-09-23). It is the
# key every login token is signed with. Empty, the app invents one each time it
# starts: just as strong, but everyone is signed out on every restart and
# deploy, which is acceptable here (people sign in again).
#
# To keep people signed in across updates, generate one on the server with:
#   openssl rand -hex 32
# and paste it below. Setting or changing it signs everyone out once; nobody
# ever sees the value. It becomes REQUIRED if the API is ever run with more
# than one worker or replica — each process would otherwise sign with its own
# key and logins would fail at random.
STOCKPILOT_JWT_SECRET=

# How long a sign-in lasts. The browser renews the short access token by
# itself, so the refresh window is what "stay signed in" really means.
STOCKPILOT_JWT_ACCESS_MINUTES=30
STOCKPILOT_JWT_REFRESH_DAYS=30

# Anyone may create an account. Set to false to close registration (existing
# accounts can still sign in).
STOCKPILOT_REGISTRATION_OPEN=true

# Comma-separated addresses that get the "admin" role when they register.
# Informational for now — the System page still uses STOCKPILOT_ADMIN_TOKEN.
STOCKPILOT_ADMIN_EMAILS=
