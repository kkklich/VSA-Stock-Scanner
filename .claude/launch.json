{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5175,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d backend-python && .venv\\Scripts\\python.exe -m uvicorn app.main:app --port 5111"
      ],
      "port": 5111
    }
  ]
}
