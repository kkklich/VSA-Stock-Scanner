# Ignore the agent directory at the root level
/agent/

# .NET build artifacts
[Bb]in/
[Oo]bj/
*.user

# Production secrets — .env.prod holds the database password and lives ONLY on
# the server. Commit .env.prod.example (the template) instead.
.env.prod
.env.production
*.pem
*.key

# Database dumps written by deploy/backup-db.sh
/backups/

# Action log (audit trail) — the rotating JSON-lines file the backend writes at
# runtime. Local to each machine; never committed.
#   backend-python/logs/  when running the backend directly (Windows, dev)
#   /logs/                on the VPS — docker-compose.prod.yml bind-mounts this
#                         folder into the api container as /app/logs
backend-python/logs/
/logs/

# Audit files written by backend-python/scripts/vsa4_run.py (the owner's VSA
# program run on a stored ticker). Local results, never committed.
backend-python/vsa4_results/

# AI layer (roadmap #31): training datasets and back-fill progress written by
# backend-python/scripts/ml_*.py. Local, large, rebuilt from the database.
backend-python/ml_data/
