# Normalise line endings.
#
# The project is edited on Windows but deployed to Linux. A shell script that
# reaches the server with Windows line endings fails with the confusing
# "/usr/bin/env: 'bash\r': No such file or directory". These rules force LF for
# everything Linux executes or parses, regardless of the local git settings.

* text=auto

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
.env.prod.example text eol=lf

# Windows launchers must keep CRLF.
*.bat       text eol=crlf

# Binary assets — never touched.
*.png       binary
*.pdf       binary
*.docx      binary
*.ico       binary
