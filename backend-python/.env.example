# Copy to ".env" and adjust. All variables are optional; defaults are shown.
# Variables use the STOCKPILOT_ prefix.

# Comma/JSON list of origins allowed by CORS (the Vite dev server is 5173).
# STOCKPILOT_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# How long per-ticker stooq history stays cached, in seconds (default 21600 = 6h).
# STOCKPILOT_HISTORY_CACHE_SECONDS=21600

# Outbound HTTP timeout for stooq.pl, in seconds.
# STOCKPILOT_STOOQ_TIMEOUT_SECONDS=30
