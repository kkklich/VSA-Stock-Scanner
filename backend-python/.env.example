# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit actual credentials.

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL URL (asyncpg driver, used at runtime).
# Leave empty to run without DB persistence (data fetched live from stooq.pl).
STOCKPILOT_DATABASE_URL=postgresql+asyncpg://stockpilot:stockpilot@localhost:5432/stockpilot

# ── CORS ──────────────────────────────────────────────────────────────────────
STOCKPILOT_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Daily ingest trigger (Europe/Warsaw timezone). GPW closes ~17:05.
STOCKPILOT_INGEST_HOUR=18
STOCKPILOT_INGEST_MINUTE=0

# ── Markets ───────────────────────────────────────────────────────────────────
# Which stock markets to serve, comma-separated: gpw, us, de, fr, nl, uk — or
# "all". The GPW is always on. See agent/MULTI-MARKET-PLAN.md before switching
# more on: every extra market adds nightly downloads and memory.
STOCKPILOT_MARKETS=gpw
# The US market's own nightly run, in America/New_York time (used only when
# "us" is served). The US closes at 16:00 New York time.
STOCKPILOT_US_INGEST_HOUR=17
STOCKPILOT_US_INGEST_MINUTE=15

# ── Live prices ───────────────────────────────────────────────────────────────
# While an exchange is open, every tracked stock's session so far (today's
# price, change and volume) is downloaded on this cadence, on the clock —
# 60 = at every full hour. Shown beside the analysis, never fed into a rating
# and never written to the database. The cadence must divide an hour (5, 10,
# 15, 20, 30 or 60). Runs only when a database is configured, like the nightly
# jobs. See app/services/live_prices.py.
STOCKPILOT_LIVE_PRICES_ENABLED=true
STOCKPILOT_LIVE_PRICES_INTERVAL_MINUTES=60

# ── HTTP client ───────────────────────────────────────────────────────────────
STOCKPILOT_STOOQ_TIMEOUT_SECONDS=30.0

# ── Action log (audit trail) ──────────────────────────────────────────────────
# Every API call and background job is recorded: what was done and when.
# Written to backend-python/logs/actions.jsonl (rotating) and, when a database
# is configured, to the `action_logs` table. Read it back at
# GET /api/admin/logs and GET /api/admin/logs/summary.
STOCKPILOT_ACTION_LOG_ENABLED=true
# Where the file goes. Relative paths are resolved against backend-python/.
STOCKPILOT_ACTION_LOG_DIR=logs
# Rotation: 10 MB per file, 5 old files kept (≈60 MB worst case).
STOCKPILOT_ACTION_LOG_FILE_MAX_BYTES=10485760
STOCKPILOT_ACTION_LOG_FILE_BACKUPS=5
# Delete stored rows older than this many days (0 = keep everything).
STOCKPILOT_ACTION_LOG_RETENTION_DAYS=30

# ── Error tracking ────────────────────────────────────────────────────────────
# Every ERROR-level log line the app writes becomes a grouped, counted error
# (grouped by what went wrong, so 290 failing tickers read as one problem seen
# 290 times). Read them back at GET /api/admin/errors; the System page in the
# UI shows them next to "did the nightly refresh run?".
STOCKPILOT_ERROR_TRACKING_ENABLED=true
# How many distinct problems are kept in memory at once.
STOCKPILOT_ERROR_TRACKING_MAX_GROUPS=200

# ── Admin API access ──────────────────────────────────────────────────────────
# /api/admin/* (the System page: logs, errors, health) shows stack traces, file
# paths and visitor IP addresses. Leave this EMPTY locally — the API is only
# reachable from your own machine. SET IT to a long random string on a public
# deployment: the endpoints then require an X-Admin-Token header with the same
# value, which you paste once into the System page.
STOCKPILOT_ADMIN_TOKEN=

# ── Sign-in / user accounts ───────────────────────────────────────────────────
# Visitors can create an account and sign in (the site itself stays public —
# every page is readable signed out). Accounts need a database: without
# STOCKPILOT_DATABASE_URL above, /api/auth/* answers 503 and the UI hides the
# sign-in button.
#
# The secret every login token is signed with. Leave EMPTY (a key is generated
# per run, so restarting the backend signs you out) — that is how this project
# runs it, locally and in production. Set it to a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# only if you want people to stay signed in across restarts; it is then also
# required if the API ever runs with more than one worker.
STOCKPILOT_JWT_SECRET=

# How long a sign-in lasts. The browser refreshes the short-lived access token
# by itself, so the refresh window is what "stay signed in" really means.
STOCKPILOT_JWT_ACCESS_MINUTES=30
STOCKPILOT_JWT_REFRESH_DAYS=30

# false closes registration (existing accounts can still sign in).
STOCKPILOT_REGISTRATION_OPEN=true

# Comma-separated addresses that get the "admin" role when they register.
# Informational for now — /api/admin/* still uses STOCKPILOT_ADMIN_TOKEN.
STOCKPILOT_ADMIN_EMAILS=
