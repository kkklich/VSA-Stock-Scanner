# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit actual credentials.

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL URL (asyncpg driver, used at runtime).
# Leave empty to run without DB persistence (data fetched live from stooq.pl).
STOCKPILOT_DATABASE_URL=postgresql+asyncpg://stockpilot:stockpilot@localhost:5432/stockpilot

# ── CORS ──────────────────────────────────────────────────────────────────────
STOCKPILOT_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Daily ingest trigger (Europe/Warsaw timezone). GPW closes ~17:05.
STOCKPILOT_INGEST_HOUR=18
STOCKPILOT_INGEST_MINUTE=0

# ── HTTP client ───────────────────────────────────────────────────────────────
STOCKPILOT_STOOQ_TIMEOUT_SECONDS=30.0
