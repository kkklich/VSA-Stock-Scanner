# Keep the build context small and secrets out of the image.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local credentials — production values come from environment variables.
.env

# Tests and docs are not needed at runtime.
tests/
README.md
requirements-dev.txt

# Local run output: the action-log file, AI datasets and VSA V4 audit files.
# Never part of the image — the server keeps its own in bind-mounted folders.
logs/
ml_data/
vsa4_results/
